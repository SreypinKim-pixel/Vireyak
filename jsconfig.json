{
  "compilerOptions": {
    "checkJs": false,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.js", "**/*.jsx", "**/*.mjs"],
  "exclude": [
    "node_modules",
    ".next",
    ".next-production",
    "test-results",
    "playwright-report"
  ]
}
