{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "TravelerReviews.tsx",
    "reviews/**/*.ts",
    "reviews/**/*.tsx",
    "DestinationCard.tsx",
    "WhyVireyak.tsx"
  ]
}
